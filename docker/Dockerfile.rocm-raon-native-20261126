# Native opt-in Raon candidates over the immutable, tested ROCm/AITER stack.
ARG BASE_IMAGE=docker.io/hanjack/vllm-rocm@sha256:9f94e15c16a2774e67ab7e841fd5e91a36f7e63c0d0a37b39227014c4cf1b537
FROM ${BASE_IMAGE}
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/jackhan-amd/vllm-rocm-raon" \
  org.opencontainers.image.revision="${VCS_REF}" \
  ai.raon.native.status="opt-in-candidates"
COPY vllm/models/raon1_mini/mhc.py \
  vllm/models/raon1_mini/rocm_mhc.py \
  vllm/models/raon1_mini/moe_align.py \
  vllm/models/raon1_mini/rocm_flydsl_combine.py \
